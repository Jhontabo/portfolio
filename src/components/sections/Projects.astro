---
import SectionHeader from '../ui/SectionHeader.astro';
import TilingWindow from '../ui/TilingWindow.astro';
import Modal from '../ui/Modal.astro';
import Icon from '../ui/Icon.astro';
import { projects } from '../../data/projects';
import { getDriveImageUrl } from '../../lib/drive';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const githubPath =
  'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z';
---

<section id="portfolio" class="py-16 sm:py-24 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-reveal>
      <SectionHeader title={t.portfolio.title} subtitle={t.portfolio.subtitle} />
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {
        projects.map((project, index) => {
          const name = locale === 'en' ? (project.nameEn ?? project.name) : project.name;
          const description =
            locale === 'en'
              ? (project.descriptionEn ?? project.description)
              : project.description;
          const image = project.imageUrl ? getDriveImageUrl(project.imageUrl) : null;
          const modalId = `project-modal-${project.id}`;

          return (
            <div data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <TilingWindow variant="cyan" title={`project_record_${project.id}.json`} hoverable>
                {image ? (
                  <button
                    type="button"
                    data-modal-open={modalId}
                    class="h-56 sm:h-64 lg:h-72 bg-zinc-900/60 flex items-center justify-center relative overflow-hidden w-full cursor-zoom-in"
                    aria-label={`Ampliar imagen de ${name}`}
                  >
                    <img
                      src={image}
                      alt={name}
                      width={640}
                      height={420}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover hover:opacity-80 transition-opacity"
                    />
                  </button>
                ) : (
                  <div class="h-56 sm:h-64 lg:h-72 bg-zinc-900/60 flex items-center justify-center relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/10 via-purple-500/5 to-transparent" />
                    <Icon
                      name="folder"
                      size={40}
                      class="w-10 h-10 text-zinc-600 group-hover:text-cyan-400 transition-colors duration-300"
                    />
                  </div>
                )}

                <div class="p-5 sm:p-6 flex-1 flex flex-col">
                  <h3 class="text-lg sm:text-xl font-semibold text-white mb-2 group-hover:text-cyan-300 transition-colors line-clamp-1">
                    {name}
                  </h3>
                  <p class="text-zinc-400 text-sm leading-relaxed mb-4 line-clamp-3">{description}</p>

                  <div class="flex flex-wrap gap-1.5 mb-5 mt-auto">
                    {project.technologies.map((tech) => (
                      <span class="text-[11px] font-mono px-2 py-0.5 bg-zinc-900 border border-white/5 text-zinc-400 rounded-md">
                        {tech}
                      </span>
                    ))}
                  </div>

                  <div class="flex gap-4 pt-4 border-t border-white/5">
                    {project.demo !== '#' && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1.5 text-base font-mono text-cyan-400 hover:text-cyan-300 transition-colors"
                      >
                        <Icon name="external-link" size={20} />
                        [live_demo]
                      </a>
                    )}
                    {project.github !== '#' && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1.5 text-base font-mono text-zinc-400 hover:text-zinc-200 transition-colors"
                      >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d={githubPath} />
                        </svg>
                        [src_code]
                      </a>
                    )}
                  </div>
                </div>
              </TilingWindow>

              {image && (
                <Modal id={modalId} variant="plain">
                  <img
                    src={image}
                    alt={name}
                    width={1200}
                    height={800}
                    decoding="async"
                    class="max-h-[85vh] max-w-full object-contain shadow-2xl"
                  />
                </Modal>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { initModals } from '../../scripts/modal';

  initModals();
</script>
