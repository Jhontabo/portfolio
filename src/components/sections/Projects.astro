---
import SectionHeader from '../ui/SectionHeader.astro';
import Modal from '../ui/Modal.astro';
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import { projects } from '../../data/projects';
import { personalInfo } from '../../data/personal';
import { getDriveImageUrl } from '../../lib/drive';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

// Tecnología -> icono de marca (solo las que existen en BrandIcon).
const techIcons: Record<string, string> = {
  React: 'react',
  'Node.js': 'nodedotjs',
  'Tailwind CSS': 'tailwindcss',
  Laravel: 'laravel',
  PHP: 'php',
  MySQL: 'mysql',
  Flutter: 'flutter',
  Dart: 'dart',
  Firebase: 'firebase',
  Bash: 'bash',
  Google: 'google',
};

const githubPath =
  'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z';
---

<section id="portfolio" class="py-32 sm:py-40 bg-[#050505] scroll-mt-24 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div data-reveal>
      <SectionHeader
        kicker={locale === 'en' ? 'SELECTED WORKS' : 'TRABAJOS SELECCIONADOS'}
        title={t.portfolio.title}
        subtitle={t.portfolio.subtitle}
      />
    </div>

    <div class="grid sm:grid-cols-2 gap-8 lg:gap-10">
      {
        projects.map((project, index) => {
          const name = locale === 'en' ? (project.nameEn ?? project.name) : project.name;
          const description =
            locale === 'en'
              ? (project.descriptionEn ?? project.description)
              : project.description;
          const image = project.imageUrl ? getDriveImageUrl(project.imageUrl) : null;
          const modalId = `project-modal-${project.id}`;

          return (
            <div data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <div class="bg-neutral-950/70 border border-white/10 hover:border-white/25 rounded-2xl overflow-hidden transition-all duration-500 flex flex-col h-full group">
                {image ? (
                  <button
                    type="button"
                    data-modal-open={modalId}
                    class="h-60 sm:h-72 bg-neutral-900/60 flex items-center justify-center relative overflow-hidden w-full cursor-zoom-in"
                    aria-label={`Ampliar imagen de ${name}`}
                  >
                    <img
                      src={image}
                      alt={name}
                      width={640}
                      height={420}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent opacity-60" />
                  </button>
                ) : (
                  <div class="h-60 sm:h-72 bg-neutral-900/40 flex items-center justify-center relative overflow-hidden">
                    <Icon
                      name="folder"
                      size={36}
                      class="text-neutral-600 group-hover:text-neutral-300 transition-colors duration-300"
                    />
                  </div>
                )}

                <div class="p-6 sm:p-8 flex-1 flex flex-col">
                  <h3 class="font-serif text-xl sm:text-2xl font-light text-white mb-3 group-hover:text-neutral-200 transition-colors line-clamp-1">
                    {name}
                  </h3>
                  <p class="text-neutral-400 text-sm font-light leading-relaxed mb-6">
                    {description}
                  </p>

                  <div class="flex flex-wrap gap-2 mb-6 mt-auto">
                    {project.technologies.map((tech) => (
                      <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.2em] font-medium px-2.5 py-1 bg-white/[0.03] border border-white/10 text-neutral-400 rounded">
                        {techIcons[tech] && (
                          <BrandIcon name={techIcons[tech]} size={13} />
                        )}
                        {tech}
                      </span>
                    ))}
                  </div>

                  <div class="flex flex-wrap items-center gap-3 pt-5 border-t border-white/10">
                    {project.demo !== '#' && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary btn-sm"
                      >
                        <span>{locale === 'en' ? 'LIVE DEMO' : 'DEMO EN VIVO'}</span>
                        <Icon name="external-link" size={13} />
                      </a>
                    )}
                    {project.github !== '#' && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-project-code
                        class="btn btn-secondary btn-sm"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d={githubPath} />
                        </svg>
                        <span>{locale === 'en' ? 'CODE' : 'CÓDIGO'}</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>

              {image && (
                <Modal
                  id={modalId}
                  variant="plain"
                  closeLabel={locale === 'en' ? 'Close dialog' : 'Cerrar modal'}
                  expandedLabel={name}
                >
                  <img
                    src={image}
                    alt={name}
                    width={1200}
                    height={800}
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="max-h-[85vh] max-w-full object-contain shadow-2xl rounded-lg"
                  />
                </Modal>
              )}
            </div>
          );
        })
      }
    </div>

    <div data-reveal class="mt-16 sm:mt-20 flex flex-col items-center text-center">
      <p class="text-[11px] uppercase tracking-[0.35em] font-medium text-neutral-500 mb-3">
        {locale === 'en' ? 'WANT TO SEE MORE?' : '¿QUIERES VER MÁS?'}
      </p>
      <h3 class="font-serif text-2xl sm:text-3xl font-light text-white max-w-xl leading-snug">
        {
          locale === 'en'
            ? 'Explore all my projects on GitHub'
            : 'Explora todos mis proyectos en GitHub'
        }
      </h3>

      <div class="relative mt-10 flex flex-col items-center">
        <div class="ball-float">
          <a
            href={personalInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={locale === 'en' ? 'View more projects on GitHub' : 'Ver más proyectos en GitHub'}
            class="github-ball group relative flex flex-col items-center justify-center w-40 h-40 sm:w-48 sm:h-48 rounded-full bg-gradient-to-br from-white via-neutral-100 to-neutral-400 text-neutral-950 border-4 border-white/90 shadow-[0_20px_70px_rgba(255,255,255,0.28)] transition-transform duration-300 hover:scale-110 hover:shadow-[0_25px_90px_rgba(255,255,255,0.4)]"
          >
          <span
            class="absolute inset-0 rounded-full border-2 border-white/40 scale-100 group-hover:scale-125 opacity-60 group-hover:opacity-0 transition-all duration-500"
            aria-hidden="true"></span>
          <svg
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="mb-2 transition-transform duration-300 group-hover:-translate-y-1 group-hover:rotate-6"
          >
            <path d={githubPath} />
          </svg>
          <span class="text-sm sm:text-base font-extrabold uppercase tracking-[0.2em] leading-none">
            {locale === 'en' ? 'VIEW MORE' : 'VER MÁS'}
          </span>
          <span class="mt-1.5 inline-flex items-center gap-1 text-[10px] sm:text-[11px] uppercase tracking-[0.25em] font-semibold text-neutral-700">
            GitHub
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
              class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10" />
            </svg>
          </span>
        </a>
        </div>
        <div class="ball-shadow mt-5 h-3 w-32 sm:w-36 rounded-full bg-white/15 blur-md" aria-hidden="true">
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initModals } from '../../scripts/modal';

  initModals();
</script>

<style>
  .ball-float {
    animation: ball-bounce 2.2s ease-in-out infinite;
    will-change: transform;
  }
  .ball-float:hover {
    animation-play-state: paused;
  }
  .ball-shadow {
    animation: shadow-pulse 2.2s ease-in-out infinite;
  }
  @keyframes ball-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-26px);
    }
  }
  @keyframes shadow-pulse {
    0%,
    100% {
      transform: scaleX(1);
      opacity: 0.5;
    }
    50% {
      transform: scaleX(0.6);
      opacity: 0.2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ball-float,
    .ball-shadow {
      animation: none;
    }
  }
</style>
