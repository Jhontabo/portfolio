---
import SectionHeader from '../ui/SectionHeader.astro';
import TilingWindow from '../ui/TilingWindow.astro';
import Icon from '../ui/Icon.astro';
import { journeyTimeline } from '../../data/journey';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const icons = ['graduation-cap', 'stethoscope', 'calendar-days'];
const branchColors = ['#00a8f4', '#a855f7', '#00e5d0'];
const readMore = locale === 'en' ? 'Read more' : 'Leer más';

const githubPath =
  'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z';

const entries = journeyTimeline.map((item, index) => {
  const color = branchColors[index % 3];
  return {
    ...item,
    color,
    icon: icons[index % 3],
    isLeft: index % 2 === 0,
    date: locale === 'en' ? item.dateEn : item.dateEs,
    title: locale === 'en' ? item.titleEn : item.titleEs,
    description: locale === 'en' ? item.descriptionEn : item.descriptionEs,
    href: item.link ?? personalInfo.github,
    hasLink: item.linkType === 'github' || !!item.link,
  };
});
---

<section id="journey" class="py-12 overflow-hidden scroll-mt-24">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-reveal>
      <SectionHeader title={t.journey.title} subtitle={t.journey.subtitle} gradient="purple" />
    </div>

    <div data-journey class="relative">
      <div
        class="absolute left-1/2 top-0 bottom-0 w-0.5 -translate-x-1/2 bg-gradient-to-b from-cyan-400/50 via-purple-500/50 to-cyan-400/50 hidden md:block"
      >
      </div>

      <div class="space-y-6 md:space-y-10">
        {
          entries.map((item, index) => {
            const cardId = `journey-card-${item.id}`;
            const cardStyle = `border-color:${item.color}60;box-shadow:0 0 25px ${item.color}25`;
            const chipStyle = `color:${item.color};border-color:${item.color}30;background-color:${item.color}10`;

            const cardBody = (
              <div class="p-5">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm sm:text-base font-mono px-3 py-1 border rounded-md" style={chipStyle}>
                    {item.date}
                  </span>
                  <div class="flex gap-1">
                    <span class="w-2 h-2 rounded-full" style="background:#ff5f56" />
                    <span class="w-2 h-2 rounded-full" style="background:#ffbd2e" />
                    <span class="w-2 h-2 rounded-full" style="background:#27c93f" />
                  </div>
                </div>
                <h3 class="text-base font-bold text-white mb-1.5">{item.title}</h3>
                <p class="text-zinc-400 text-sm leading-relaxed mb-3">{item.description}</p>
                {item.hasLink && (
                  <div class="pt-2 border-t border-white/5">
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-mono text-cyan-300 hover:text-cyan-200 transition-colors"
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d={githubPath} />
                      </svg>
                      <span>[view_repo]</span>
                    </a>
                  </div>
                )}
              </div>
            );

            return (
              <div data-journey-entry={item.id} data-expanded="false" class="relative">
                {/* Desktop */}
                <div class="hidden md:flex items-center justify-center" data-reveal>
                  {item.isLeft ? (
                    <>
                      <div class="flex-[0_0_calc(50%-32px)] flex justify-end pr-8">
                        <TilingWindow class="p-5 w-full max-w-sm" style={cardStyle}>
                          {cardBody}
                        </TilingWindow>
                      </div>
                      <div class="shrink-0 w-12 flex justify-center relative z-10">
                        <div
                          class="w-3 h-3 rounded-full border-2"
                          style={`border-color:${item.color};box-shadow:0 0 10px ${item.color}80;background:#040406`}
                        />
                      </div>
                      <div class="flex-[0_0_calc(50%-32px)]" />
                    </>
                  ) : (
                    <>
                      <div class="flex-[0_0_calc(50%-32px)]" />
                      <div class="shrink-0 w-12 flex justify-center relative z-10">
                        <div
                          class="w-3 h-3 rounded-full border-2"
                          style={`border-color:${item.color};box-shadow:0 0 10px ${item.color}80;background:#040406`}
                        />
                      </div>
                      <div class="flex-[0_0_calc(50%-32px)] flex justify-start pl-8">
                        <TilingWindow class="p-5 w-full max-w-sm" style={cardStyle}>
                          {cardBody}
                        </TilingWindow>
                      </div>
                    </>
                  )}
                </div>

                {/* Mobile */}
                <div class="flex md:hidden flex-col items-center">
                  {index > 0 && (
                    <div
                      class="w-0.5 h-8 mb-4"
                      style={`background:linear-gradient(to bottom, ${item.color}30, ${item.color}70)`}
                    />
                  )}

                  <button
                    type="button"
                    data-journey-toggle
                    aria-expanded="false"
                    aria-controls={cardId}
                    class="journey-bubble w-44 h-44 sm:w-56 sm:h-56 max-w-full rounded-full flex flex-col items-center justify-center p-3 sm:p-6 text-center border-2 bg-[#0b0c10]/90"
                    style={`--accent:${item.color};--accent-15:${item.color}15;--accent-50:${item.color}50;--accent-25:${item.color}25;--accent-60:${item.color}60;--accent-30:${item.color}30;--accent-10:${item.color}10`}
                  >
                    <span class="journey-chip p-2 rounded-full border mb-2 flex items-center justify-center" style={`color:${item.color};border-color:${item.color}30;background-color:${item.color}10`}>
                      <Icon name={item.icon} size={20} />
                    </span>
                    <span class="journey-cta text-base font-bold font-mono mb-1" style={`color:${item.color}`}>
                      {item.date}
                    </span>
                    <span class="text-sm font-semibold text-zinc-200 mb-3 leading-tight line-clamp-2 max-w-[15ch]">
                      {item.title}
                    </span>
                    <span class="journey-read text-[10px] font-mono uppercase tracking-widest font-semibold" style={`color:${item.color}`}>
                      {readMore}
                    </span>
                  </button>

                  <div id={cardId} data-journey-card hidden class="w-full max-w-sm">
                    <TilingWindow class="p-4" style={cardStyle}>
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-sm sm:text-base font-mono px-3 py-1 border rounded-md" style={chipStyle}>
                          {item.date}
                        </span>
                        <div class="flex gap-1">
                          <span class="w-2 h-2 rounded-full" style="background:#ff5f56" />
                          <span class="w-2 h-2 rounded-full" style="background:#ffbd2e" />
                          <span class="w-2 h-2 rounded-full" style="background:#27c93f" />
                        </div>
                      </div>
                      <h3 class="text-base font-bold text-white mb-1.5">{item.title}</h3>
                      <p class="text-zinc-400 text-sm leading-relaxed mb-3">{item.description}</p>
                      <div class="flex items-center justify-between pt-2 border-t border-white/5">
                        {item.hasLink && (
                          <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 text-sm font-mono text-cyan-300 hover:text-cyan-200 transition-colors"
                          >
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                              <path d={githubPath} />
                            </svg>
                            <span>[view_repo]</span>
                          </a>
                        )}
                        <button
                          type="button"
                          data-journey-close
                          class="ml-auto text-[10px] font-mono text-zinc-500 hover:text-zinc-300 transition-colors"
                        >
                          [close]
                        </button>
                      </div>
                    </TilingWindow>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .journey-bubble {
    border-color: var(--accent-60);
    box-shadow:
      0 0 15px var(--accent-15),
      0 4px 20px rgba(0, 0, 0, 0.4);
    transition:
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      transform 0.5s ease;
    cursor: pointer;
  }

  .journey-bubble:hover {
    border-color: var(--accent);
    box-shadow:
      0 0 25px var(--accent-50),
      0 0 50px var(--accent-25);
    transform: scale(1.05);
  }

  .journey-chip,
  .journey-read {
    transition:
      transform 0.3s ease,
      letter-spacing 0.3s ease;
  }

  .journey-bubble:hover .journey-chip {
    transform: scale(1.1);
  }

  .journey-bubble:hover .journey-read {
    transform: scale(1.1);
    letter-spacing: 0.15em;
  }

  [data-journey-card] {
    animation: journey-card-in 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  [data-journey-entry][data-expanded='true'] .journey-bubble {
    display: none;
  }

  @keyframes journey-card-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-bubble:hover {
      transform: none;
    }
  }
</style>

<script>
  import { initJourney } from '../../scripts/journey';

  initJourney();
</script>
