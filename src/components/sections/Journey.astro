---
import Icon from '../ui/Icon.astro';
import { journeyTimeline } from '../../data/journey';
import { personalInfo } from '../../data/personal';
import type { JourneyCategory } from '../../data/types';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const githubPath =
  'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z';

interface CategoryStyle {
  icon: string;
  chip: string;
  text: string;
  border: string;
  dot: string;
  shadow: string;
}

const categoryStyles: Record<JourneyCategory, CategoryStyle> = {
  education: {
    icon: 'graduation-cap',
    chip: 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30',
    text: 'text-indigo-400',
    border: 'border-indigo-500',
    dot: 'bg-indigo-500',
    shadow: 'shadow-indigo-500/30',
  },
  work: {
    icon: 'briefcase',
    chip: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
    text: 'text-cyan-400',
    border: 'border-cyan-400',
    dot: 'bg-cyan-400',
    shadow: 'shadow-cyan-400/30',
  },
  research: {
    icon: 'award',
    chip: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
    text: 'text-emerald-400',
    border: 'border-emerald-400',
    dot: 'bg-emerald-400',
    shadow: 'shadow-emerald-400/30',
  },
  marketing: {
    icon: 'megaphone',
    chip: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
    text: 'text-emerald-400',
    border: 'border-emerald-400',
    dot: 'bg-emerald-400',
    shadow: 'shadow-emerald-400/30',
  },
};

const entries = journeyTimeline.map((item, index) => {
  const category = categoryStyles[item.category];
  return {
    ...item,
    category,
    delay: index * 80,
    isCurrent: !!item.current,
    side: index % 2 === 0 ? 'left' : 'right',
    date: locale === 'en' ? item.dateEn : item.dateEs,
    title: locale === 'en' ? item.titleEn : item.titleEs,
    description: locale === 'en' ? item.descriptionEn : item.descriptionEs,
    label: t.journey.categories[item.category],
    href: item.link ?? personalInfo.github,
    hasLink: item.linkType === 'github' || !!item.link,
  };
});

const now = new Date();
const todayLabel = `${new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'es-CO', { month: 'long' }).format(now)} ${now.getFullYear()}`;
---

<section
  id="journey"
  class="relative py-32 sm:py-40 bg-[#050505] overflow-hidden scroll-mt-24 border-t border-white/5"
>
  <!-- Fondo de gradientes dinámicos -->
  <div
    class="pointer-events-none absolute -top-10 left-1/4 h-80 w-80 rounded-full bg-indigo-600/10 blur-[110px]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-1/2 -right-10 h-80 w-80 rounded-full bg-cyan-500/10 blur-[110px]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-10 left-1/3 h-72 w-72 rounded-full bg-emerald-500/10 blur-[110px]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8">
    <!-- Encabezado -->
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-20" data-reveal>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-950/50 border border-cyan-500/30 text-cyan-300 text-xs font-semibold tracking-wider uppercase mb-4">
        <Icon name="award" size={13} />
        {locale === 'en' ? 'Timeline' : 'Trayectoria'}
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white">
        {t.journey.title}
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-3">{t.journey.subtitle}</p>
    </div>

    <!-- Contenedor del Roadmap -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Línea central del Roadmap -->
      <div
        class="timeline-line absolute left-4 sm:left-1/2 top-4 bottom-4 w-0.5 sm:-translate-x-1/2 z-0"
        aria-hidden="true"
      ></div>

      <div class="space-y-12 relative">
        {entries.map((item) => (
          <div
            class={`relative flex flex-col sm:flex-row items-start sm:items-center ${item.side === 'right' ? 'sm:flex-row-reverse' : ''}`}
            data-reveal
            style={`--reveal-delay: ${item.delay}ms`}
          >
            <!-- Contenido -->
            <div
              class={`w-full pl-12 sm:w-1/2 ${
                item.side === 'left'
                  ? 'sm:pl-0 sm:pr-10 sm:text-right'
                  : 'sm:pl-10 sm:pr-0 sm:text-left'
              }`}
            >
              <div
                class={
                  item.isCurrent
                    ? 'rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-950/40 to-slate-900 p-5 shadow-xl'
                    : ''
                }
              >
                <span class="inline-flex flex-wrap items-center gap-2 mb-1">
                  <span
                    class={`inline-block text-xs font-mono font-bold px-2.5 py-1 rounded-md border ${item.category.chip}`}
                  >
                    {item.date}
                  </span>
                  {item.isCurrent && (
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-emerald-300">
                      <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-400" />
                      </span>
                      {locale === 'en' ? `Now · ${todayLabel}` : `Actual · ${todayLabel}`}
                    </span>
                  )}
                </span>
                <h3 class="text-lg font-bold text-white">{item.title}</h3>
                <div
                  class={`text-xs font-mono ${item.category.text} font-semibold mt-1 mb-2 flex items-center gap-1.5 ${
                    item.side === 'left' ? 'sm:justify-end' : ''
                  }`}
                >
                  <Icon name={item.category.icon} size={13} />
                  {item.label}
                </div>
                <p class="text-sm text-slate-300 leading-relaxed">{item.description}</p>

                {item.hasLink && (
                  <div class={`pt-4 ${item.side === 'left' ? 'sm:flex sm:justify-end' : ''}`}>
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-secondary btn-sm"
                    >
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={githubPath} />
                      </svg>
                      <span>{locale === 'en' ? 'VIEW REPO' : 'VER REPOSITORIO'}</span>
                    </a>
                  </div>
                )}
              </div>
            </div>

            <!-- Lado opuesto: año o insignia de rol actual -->
            <div
              class={`hidden sm:block sm:w-1/2 ${
                item.side === 'left' ? 'sm:pl-10 sm:text-left' : 'sm:pr-10 sm:text-right'
              }`}
            >
              {item.isCurrent ? (
                <span class="inline-block px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider animate-pulse border border-emerald-500/30">
                  {locale === 'en' ? 'Current Role' : 'Rol Actual'}
                </span>
              ) : (
                <span class="text-2xl font-black text-slate-700 font-mono">{item.year}</span>
              )}
            </div>

            <!-- Nodo indicador -->
            {item.isCurrent ? (
              <div class="absolute left-4 sm:left-1/2 top-1 sm:top-1/2 w-10 h-10 rounded-full bg-emerald-500/20 border-2 border-emerald-400 flex items-center justify-center -translate-x-1/2 sm:-translate-y-1/2 shadow-lg shadow-emerald-500/40 z-10">
                <div class="w-4 h-4 rounded-full bg-emerald-400 animate-ping" />
              </div>
            ) : (
              <div
                class={`absolute left-4 sm:left-1/2 top-1 sm:top-1/2 w-8 h-8 rounded-full bg-[#050505] border-2 ${item.category.border} flex items-center justify-center -translate-x-1/2 sm:-translate-y-1/2 shadow-lg ${item.category.shadow} z-10`}
              >
                <div class={`w-3 h-3 rounded-full ${item.category.dot}`} />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-line {
    background: linear-gradient(180deg, #6366f1 0%, #06b6d4 50%, #10b981 100%);
  }
</style>
