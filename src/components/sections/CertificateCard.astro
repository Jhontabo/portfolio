---
import Modal from '../ui/Modal.astro';
import Icon from '../ui/Icon.astro';
import { getPreviewUrl, getThumbnailUrl } from '../../lib/drive';
import type { Certificate } from '../../data/types';
import type { Locale } from '../../i18n';

export interface Props {
  cert: Certificate;
  locale: Locale;
  revealDelay?: string;
}

const { cert, locale, revealDelay } = Astro.props;

const name = locale === 'en' ? cert.nameEn || cert.name : cert.name;
const modalId = `cert-modal-${cert.id}`;
const thumb = getThumbnailUrl(cert.link);
---

<div
  data-reveal={revealDelay ? '' : undefined}
  style={revealDelay ? `--reveal-delay:${revealDelay}` : undefined}
>
  <div class="bg-neutral-950/70 border border-white/10 hover:border-white/25 rounded-2xl p-6 sm:p-7 flex flex-col h-full transition-all duration-300 group">
    <div class="mb-4">
      <p class="text-[10px] sm:text-[11px] uppercase tracking-[0.22em] text-neutral-400 font-medium mb-1.5">
        {cert.issuer}
      </p>
      <h3 class="font-serif text-lg sm:text-xl font-light text-white group-hover:text-neutral-200 transition-colors line-clamp-2">
        {name}
      </h3>
    </div>

    {thumb && (
      <div class="mb-5 rounded-xl overflow-hidden border border-white/10 bg-neutral-900/30">
        <img
          src={thumb}
          alt={name}
          width={400}
          height={300}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class="w-full max-h-56 object-contain group-hover:scale-[1.02] transition-transform duration-500"
        />
      </div>
    )}

    <div class="flex items-center justify-end mt-auto pt-4 border-t border-white/10">
      <button type="button" data-modal-open={modalId} class="btn btn-secondary btn-sm">
        <span>{locale === 'en' ? 'VIEW CREDENTIAL' : 'VER CREDENCIAL'}</span>
        <Icon name="external-link" size={12} />
      </button>
    </div>
  </div>

  <Modal
    id={modalId}
    title={name}
    bodyClass="flex-1 min-h-0 bg-neutral-900"
    closeLabel={locale === 'en' ? 'Close dialog' : 'Cerrar modal'}
  >
    <iframe
      data-deferred-src={getPreviewUrl(cert.link) ?? cert.link}
      title={name}
      class="w-full h-full min-h-0 flex-1 border-0"
      allow="autoplay"
      loading="lazy"
      referrerpolicy="no-referrer"
    ></iframe>
  </Modal>
</div>
