---
import SectionHeader from '../ui/SectionHeader.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import { CATEGORY_ORDER, VISIBLE_SKILL_COUNT, skills } from '../../data/skills';
import type { SkillCategory } from '../../data/types';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const categoryIcons: Record<SkillCategory, string> = {
  languages: 'code-xml',
  frontend: 'terminal',
  backend: 'server',
  mobile: 'smartphone',
  tools: 'wrench',
  marketing: 'megaphone',
};
---

<section id="skills" class="py-24 sm:py-32 bg-[#050505] scroll-mt-24 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div data-reveal>
      <SectionHeader
        kicker={locale === 'en' ? 'CAPABILITIES' : 'DOMINIO TÉCNICO'}
        title={t.skills.title}
      />
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        CATEGORY_ORDER.map((category, catIndex) => {
          const list = skills[category];
          const first = list.slice(0, VISIBLE_SKILL_COUNT);
          const rest = list.slice(VISIBLE_SKILL_COUNT);
          const panelId = `skills-extra-${category}`;

          const row = (skill: { name: string; icon: string }, index: number) => (
            <div
              data-reveal="slide-left"
              class="flex items-center gap-3 p-2.5 bg-white/[0.02] border border-white/5 hover:border-white/15 rounded-xl transition-colors"
              style={`--reveal-delay: ${catIndex * 80 + index * 40}ms`}
            >
              <span class="shrink-0 flex items-center justify-center w-7 h-7 rounded-lg bg-neutral-900 border border-white/5 text-neutral-300">
                <BrandIcon name={skill.icon} size={16} />
              </span>
              <span class="text-neutral-300 text-xs sm:text-sm font-light tracking-wide">{skill.name}</span>
            </div>
          );

          return (
            <div
              data-reveal
              class="bg-neutral-950/70 border border-white/10 hover:border-white/20 rounded-2xl p-6 sm:p-7 flex flex-col h-full transition-all duration-300"
              style={`--reveal-delay: ${catIndex * 80}ms`}
            >
              <div class="flex items-center gap-3 mb-6">
                <div class="w-9 h-9 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-neutral-300 shrink-0">
                  <Icon name={categoryIcons[category]} size={18} />
                </div>
                <h3 class="font-serif text-lg font-light text-white tracking-wide">{t.skills[category]}</h3>
              </div>

              <div class="space-y-2.5 flex-1">
                {first.map(row)}

                {rest.length > 0 && (
                  <div id={panelId} class="expandable">
                    <div class="space-y-2.5 pt-2.5">
                      {rest.map((skill, index) => row(skill, VISIBLE_SKILL_COUNT + index))}
                    </div>
                  </div>
                )}
              </div>

              {rest.length > 0 && (
                <button
                  type="button"
                  data-skills-toggle
                  aria-expanded="false"
                  aria-controls={panelId}
                  class="mt-5 inline-flex items-center justify-center gap-2 w-full py-2.5 text-xs font-medium uppercase tracking-[0.2em] text-neutral-400 hover:text-white bg-white/[0.03] hover:bg-white/[0.07] border border-white/10 rounded-xl transition-all"
                >
                  <span data-skills-label-more>{t.skills.showMore}</span>
                  <span data-skills-label-less hidden>{t.skills.showLess}</span>
                  <span data-skills-chevron class="transition-transform duration-300 inline-flex">
                    <Icon name="chevron-down" size={13} />
                  </span>
                </button>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { initSkills } from '../../scripts/skills';

  initSkills();
</script>
