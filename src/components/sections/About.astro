---
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const bio = locale === 'en' ? personalInfo.bioEn : personalInfo.bioEs;
const roles = t.hero.roles;
---

<section id="about" class="py-32 sm:py-40 bg-[#050505] relative overflow-hidden border-t border-white/5 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 w-full">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Columna Izquierda: Presentación Editorial (unificada) -->
      <div class="lg:col-span-7 flex flex-col" data-reveal>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-neutral-300 mb-4">
          {locale === 'en' ? 'ABOUT ME' : 'SOBRE MÍ'}
        </p>

        <h2 class="font-serif text-4xl sm:text-6xl font-light uppercase tracking-[0.1em] text-white leading-[1.1] mb-6">
          Jhon<br />
          <span class="text-neutral-300">Tajumbina</span>
        </h2>

        <div class="w-14 h-[2px] bg-gradient-to-r from-white/60 to-transparent mb-8" aria-hidden="true"></div>

        <p class="text-base sm:text-lg text-neutral-300 font-light leading-relaxed mb-8">
          {bio}
        </p>

        <ul class="flex flex-wrap gap-2.5 mb-8" aria-label={locale === 'en' ? 'Roles' : 'Roles'}>
          {
            roles.map((role) => (
              <li class="text-[11px] font-medium uppercase tracking-[0.18em] px-3.5 py-2 rounded-full border border-white/15 bg-white/[0.03] text-neutral-300">
                {role}
              </li>
            ))
          }
        </ul>

        <p class="text-sm text-neutral-400 font-light leading-relaxed border-l-2 border-white/20 pl-4">
          {locale === 'en'
            ? 'Driven by precision, clean architectures, and high-conversion strategies that bridge engineering excellence with measurable business growth.'
            : 'Arquitecturas limpias, rendimiento técnico y estrategias de conversión que unen la excelencia en ingeniería con resultados de negocio medibles.'}
        </p>
      </div>

      <!-- Columna Derecha: Retrato -->
      <div class="lg:col-span-5" data-reveal style="--reveal-delay: 150ms">
        <figure class="relative max-w-sm w-full mx-auto lg:ml-auto">
          <div
            class="absolute -inset-3 rounded-[20px] border border-white/10 pointer-events-none"
            aria-hidden="true"
          ></div>
          <div class="relative rounded-2xl overflow-hidden border border-white/15 shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
            <img
              src="/diseno-footer.webp"
              alt="Jhon Tajumbina"
              width={900}
              height={1200}
              loading="lazy"
              decoding="async"
              class="w-full aspect-[3/4] object-cover object-[50%_20%] pointer-events-none select-none"
            />
            <div
              class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/70 to-transparent pointer-events-none"
              aria-hidden="true"
            ></div>
            <figcaption class="absolute bottom-4 left-0 right-0 text-center">
              <span class="font-serif text-sm tracking-[0.28em] uppercase text-white">
                Jhon Tajumbina
              </span>
            </figcaption>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

