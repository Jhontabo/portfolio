---
import Icon from '../ui/Icon.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const bio = locale === 'en' ? personalInfo.bioEn : personalInfo.bioEs;
const roles = t.hero.roles;

const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<section id="about" class="py-24 sm:py-32 bg-[#050505] relative overflow-hidden border-t border-white/5 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 w-full">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Columna Izquierda: Presentación Editorial -->
      <div class="lg:col-span-7 flex flex-col" data-reveal>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-neutral-300 mb-4">
          {locale === 'en' ? 'ABOUT ME' : 'SOBRE MÍ'}
        </p>

        <h2 class="font-serif text-4xl sm:text-6xl font-light uppercase tracking-[0.1em] text-white leading-[1.1] mb-6">
          Jhon<br />
          <span class="text-neutral-300">Tajumbina</span>
        </h2>

        <div class="w-14 h-[2px] bg-gradient-to-r from-white/60 to-transparent mb-8" aria-hidden="true"></div>

        <p class="text-base sm:text-lg text-neutral-300 font-light leading-relaxed mb-6">
          {bio}
        </p>

        <!-- Botones de Acción Editorial -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/cv.pdf" download class="btn btn-primary">
            <Icon name="download" size={14} />
            {t.hero.downloadCV}
          </a>

          <a
            href={personalInfo.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={linkedinPath}></path>
            </svg>
            {t.hero.contactMe}
          </a>

          <a href="#portfolio" class="btn btn-secondary">
            {t.hero.viewProjects}
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Tarjetas de Especialidad / Enfoque -->
      <div class="lg:col-span-5 flex flex-col gap-4 lg:pt-8" data-reveal style="--reveal-delay: 150ms">
        <div class="bg-neutral-950/60 border border-white/10 rounded-2xl p-6 sm:p-8 backdrop-blur-sm">
          <p class="text-[10px] font-medium uppercase tracking-[0.25em] text-neutral-400 mb-2">
            {locale === 'en' ? 'CORE DISCIPLINES' : 'DISCIPLINAS PRINCIPALES'}
          </p>
          <h3 class="font-serif text-xl sm:text-2xl text-white font-light tracking-wide mb-4">
            {locale === 'en' ? 'Engineering & Digital Strategy' : 'Ingeniería & Estrategia Digital'}
          </h3>
          <ul class="space-y-3">
            {
              roles.map((role) => (
                <li class="flex items-center gap-3 text-sm text-neutral-300 font-light">
                  <span class="w-1.5 h-1.5 rounded-full bg-neutral-400"></span>
                  <span>{role}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-neutral-950/40 border border-white/5 rounded-2xl p-6 sm:p-8">
          <p class="text-[10px] font-medium uppercase tracking-[0.25em] text-neutral-400 mb-2">
            {locale === 'en' ? 'FOCUS & METHOD' : 'FILOSOFÍA DE TRABAJO'}
          </p>
          <p class="text-sm text-neutral-400 font-light leading-relaxed">
            {locale === 'en'
              ? 'Driven by precision, clean architectures, and high-conversion strategies that bridge engineering excellence with measurable business growth.'
              : 'Arquitecturas limpias, rendimiento técnico y estrategias de conversión que unen la excelencia en ingeniería con resultados de negocio medibles.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
