---
import SectionHeader from '../ui/SectionHeader.astro';
import CertificateCard from './CertificateCard.astro';
import Icon from '../ui/Icon.astro';
import { certificates, certificatesFolderUrl } from '../../data/certificates';
import { INITIAL_CERT_COUNT } from '../../scripts/certificates';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const visible = certificates.slice(0, INITIAL_CERT_COUNT);
---

<section id="certificates" class="py-32 sm:py-40 bg-[#050505] scroll-mt-24 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div data-reveal>
      <SectionHeader
        kicker={locale === 'en' ? 'ACCREDITATIONS' : 'RECONOCIMIENTO'}
        title={t.certificates.title}
      />
    </div>

    <div class="grid sm:grid-cols-2 gap-8 lg:gap-10">
      {
        visible.map((cert, index) => (
          <CertificateCard cert={cert} locale={locale} revealDelay={`${index * 80}ms`} />
        ))
      }
    </div>

    <div class="mt-12 sm:mt-16" data-reveal>
      <div class="flex justify-center">
      <a
        href={certificatesFolderUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cert-folder
        data-tour-title={locale === 'en' ? 'Everything in one place' : 'Todo en un solo lugar'}
        data-tour-desc={
          locale === 'en'
            ? 'Open the Drive folder with the rest of my certifications.'
            : 'Abre la carpeta de Drive con el resto de mis certificaciones.'
        }
        data-tour-done={locale === 'en' ? 'Got it' : 'Entendido'}
        class="folder-cta group relative w-full sm:w-auto sm:min-w-[560px] flex items-center gap-6 bg-[#38bdf8]/[0.06] border border-[#38bdf8]/40 hover:border-[#38bdf8] rounded-2xl px-8 sm:px-10 py-7 sm:py-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_60px_rgba(56,189,248,0.28)] overflow-hidden"
      >
        <span
          class="shine pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-transparent via-white/15 to-transparent"
          aria-hidden="true"
        ></span>
        <span
          class="absolute top-4 right-4 inline-flex items-center gap-1.5 rounded-full bg-[#38bdf8] text-black text-[10px] font-bold uppercase tracking-[0.18em] px-3.5 py-1.5 shadow-[0_4px_20px_rgba(56,189,248,0.5)]"
        >
          {locale === 'en' ? 'Open' : 'Abrir'}
          <Icon name="external-link" size={12} />
        </span>
        <span
          class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-[#38bdf8]/80 to-transparent"
          aria-hidden="true"
        ></span>
        <span class="relative shrink-0 w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-[#38bdf8]/10 border border-[#38bdf8]/40 flex items-center justify-center text-[#7dd3fc] group-hover:border-[#38bdf8] group-hover:scale-105 group-hover:shadow-[0_0_30px_rgba(56,189,248,0.35)] transition-all duration-300">
          <Icon name="folder" size={40} />
          <span
            class="absolute -bottom-2 -right-2 w-9 h-9 rounded-full bg-gradient-to-br from-[#38bdf8] to-[#0369a1] border-2 border-[#050505] flex items-center justify-center text-[11px] font-bold tracking-wider text-white shadow-[0_4px_14px_rgba(56,189,248,0.45)]"
            aria-hidden="true"
          >
            JT
          </span>
        </span>
        <span class="flex-1 min-w-0 text-left">
          <span class="flex items-center gap-2.5 text-base sm:text-lg font-semibold uppercase tracking-[0.22em] text-white">
            {t.certificates.viewFolder}
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#38bdf8] opacity-70"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7dd3fc]"></span>
            </span>
          </span>
          <span class="block text-sm text-neutral-400 font-light mt-1.5">
            {locale === 'en'
              ? 'The rest of my certifications live here'
              : 'Aquí está el resto de mis certificaciones'}
          </span>
        </span>
        <Icon
          name="arrow-right"
          size={20}
          class="shrink-0 text-[#38bdf8]/70 group-hover:text-[#7dd3fc] group-hover:translate-x-1.5 transition-all duration-300"
        />
      </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Pulso de atención cada pocos segundos para indicar que es clicable */
  @keyframes folder-glow {
    0%,
    100% {
      box-shadow: 0 0 0 rgba(56, 189, 248, 0);
    }
    50% {
      box-shadow: 0 0 34px rgba(56, 189, 248, 0.28);
    }
  }

  .folder-cta {
    animation: folder-glow 2.8s ease-in-out infinite;
  }

  .folder-cta:hover {
    animation-play-state: paused;
  }

  /* Barrido de brillo que cruza la tarjeta cada pocos segundos */
  @keyframes shine-sweep {
    0% {
      transform: translateX(-160%) skewX(-12deg);
    }
    55%,
    100% {
      transform: translateX(420%) skewX(-12deg);
    }
  }

  .folder-cta .shine {
    transform: translateX(-160%) skewX(-12deg);
    animation: shine-sweep 4.2s ease-in-out infinite;
  }

  .folder-cta:hover .shine {
    animation-play-state: paused;
  }
</style>

<script>
  import { driver } from 'driver.js';
  import { initModals } from '../../scripts/modal';

  initModals();

  // Tour de un paso hacia la carpeta: una sola vez, cuando entra en pantalla.
  const folder = document.querySelector<HTMLElement>('[data-cert-folder]');
  const KEY = 'jtour-cert-folder-v1';
  let seen = false;
  try {
    seen = localStorage.getItem(KEY) === '1';
  } catch {
    seen = false;
  }
  const mark = (): void => {
    try {
      localStorage.setItem(KEY, '1');
    } catch {
      /* almacenamiento no disponible */
    }
  };

  if (folder && !seen) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      mark();
    } else {
      const show = (): void => {
        if (!folder || folder.getBoundingClientRect().width === 0) {
          mark();
          return;
        }
        driver({
          popoverClass: 'jtour-popover',
          stagePadding: 8,
          allowClose: true,
          showProgress: false,
          doneBtnText: folder.getAttribute('data-tour-done') ?? 'OK',
          onDestroyed: mark,
          steps: [
            {
              element: folder,
              popover: {
                title: folder.getAttribute('data-tour-title') ?? '',
                description: folder.getAttribute('data-tour-desc') ?? '',
                side: 'top',
                align: 'center',
              },
            },
          ],
        }).drive();
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              io.disconnect();
              window.setTimeout(show, 600);
            });
          },
          { threshold: 0.4 },
        );
        io.observe(folder);
      } else {
        show();
      }
    }
  }
</script>
