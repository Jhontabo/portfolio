---
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale } = Astro.props;
---

<section
  id="home"
  class="relative w-full min-h-[70svh] sm:min-h-[85svh] lg:h-[100svh] lg:min-h-[640px] flex items-center justify-center overflow-hidden bg-[#050505]"
>
  <!-- Nombre visible en la parte superior del hero (encima del banner) -->
  <h1
    class="absolute top-24 sm:top-28 lg:top-32 left-1/2 -translate-x-1/2 z-20 w-full px-6 text-center font-serif font-medium uppercase text-white text-xl sm:text-4xl lg:text-5xl tracking-[0.18em] sm:tracking-[0.3em] pointer-events-none select-none [text-shadow:0_2px_20px_rgba(0,0,0,0.8)]"
  >
    Jhon Tajumbina
  </h1>

  <!-- 1. Banner con wrapper que adapta dimensiones exactas en cualquier dispositivo -->
  <div class="hero-image-wrapper relative z-0 w-full flex items-center justify-center select-none">
    <picture class="contents">
      <source media="(max-width: 767px)" srcset="/desing-mobil.webp" />
      <img
        src="/Desing-final.webp"
        srcset="/Desing-final-1200.webp 1200w, /Desing-final-1600.webp 1600w, /Desing-final.webp 2400w"
        sizes="100vw"
        alt="Jhon Tajumbina"
        width="2400"
        height="1260"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-banner object-center pointer-events-none"
      />
    </picture>

    <!-- Fundido perimetral superior (suaviza el borde superior del banner con #050505) -->
    <div
      class="absolute inset-x-0 top-0 h-14 sm:h-20 md:h-28 bg-gradient-to-b from-[#050505] via-[#050505]/70 to-transparent pointer-events-none z-10"
      aria-hidden="true"
    >
    </div>

    <!-- Fundido perimetral inferior (suaviza el borde inferior del banner con #050505) -->
    <div
      class="absolute inset-x-0 bottom-0 h-16 sm:h-24 md:h-32 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-transparent pointer-events-none z-10"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Fundido superior global fijo bajo el header navbar -->
  <div
    class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-black/80 to-transparent pointer-events-none z-10"
    aria-hidden="true"
  >
  </div>

  <!-- Indicador discreto de scroll (Estilo editorial de alta gama) -->
  <a
    href="#about"
    aria-label={locale === 'en' ? 'Scroll down to about' : 'Desplazarse a sobre mí'}
    class="absolute bottom-5 sm:bottom-7 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-1.5 text-neutral-400 hover:text-white transition-colors duration-300 pointer-events-auto group"
  >
    <span class="text-[9px] uppercase tracking-[0.3em] font-medium text-neutral-400 group-hover:text-white transition-colors">
      {locale === 'en' ? 'SCROLL' : 'DESCUBRIR'}
    </span>
    <svg
      class="w-3.5 h-3.5 text-neutral-400 group-hover:text-white transition-transform group-hover:translate-y-0.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </a>
</section>
