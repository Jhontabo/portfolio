---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import jhon from '../../assets/jhon.png';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const roles = t.hero.roles;
const bio = locale === 'en' ? personalInfo.bioEn : personalInfo.bioEs;
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<section
  id="home"
  class="min-h-screen flex items-center justify-center pt-24 pb-16 relative overflow-hidden dot-grid scroll-mt-24"
>
  <div
    class="absolute top-1/4 left-1/4 w-[300px] h-[300px] bg-cyan-500/10 rounded-full blur-[100px] pointer-events-none -z-10 animate-pulse duration-[8000ms]"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-[350px] h-[350px] bg-purple-500/10 rounded-full blur-[120px] pointer-events-none -z-10 animate-pulse duration-[10000ms]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col text-left animate-fade-in-left">
        <h1
          class="text-3xl sm:text-5xl lg:text-7xl font-extrabold text-white mb-4 tracking-tight leading-[1.05]"
        >
          Jhon<br />
          <span class="hypr-gradient-text font-black">Tajumbina</span>
        </h1>

        <p
          class="text-lg sm:text-2xl text-zinc-400 mb-6 font-medium font-mono min-h-[2rem]"
          data-typewriter
          data-roles={JSON.stringify(roles)}
        >
          <span class="text-purple-400">&gt; </span><span data-typewriter-output>{roles[0]}</span><span
            class="animate-pulse text-cyan-400 ml-0.5">▊</span
          >
        </p>

        <p class="text-sm sm:text-base text-zinc-400 leading-relaxed mb-8 max-w-2xl">
          {bio}
        </p>

        <div class="flex flex-wrap gap-4 mt-2">
          <a
            href="#portfolio"
            class="flex items-center gap-2 glow-btn-cyan rounded-full px-6 py-3 font-medium text-sm transition-all hover:scale-[1.02] active:scale-[0.98]"
          >
            {t.hero.viewProjects}
            <Icon name="arrow-right" size={16} />
          </a>

          <a
            href="/cv.pdf"
            download
            class="flex items-center gap-2 border border-white/10 hover:border-purple-500/40 text-zinc-300 hover:text-white rounded-full px-6 py-3 font-medium text-sm transition-all bg-white/5 backdrop-blur-sm hover:bg-white/[0.08] hover:scale-[1.02] active:scale-[0.98]"
          >
            <Icon name="download" size={16} />
            {t.hero.downloadCV}
          </a>

          <a
            href={personalInfo.linkedin}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 border border-white/10 hover:border-cyan-500/40 text-zinc-300 hover:text-white rounded-full px-6 py-3 font-medium text-sm transition-all bg-white/5 backdrop-blur-sm hover:bg-white/[0.08] hover:scale-[1.02] active:scale-[0.98]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={linkedinPath}></path>
            </svg>
            {t.hero.contactMe}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 flex justify-center animate-fade-in-right">
        <div
          class="relative w-72 h-72 sm:w-80 sm:h-80 max-w-full rounded-full overflow-hidden border-2 border-cyan-400/30 shadow-[0_0_60px_rgba(34,211,238,0.15)] bg-zinc-900"
        >
          <Image
            src={jhon}
            alt="Jhon Tajumbina"
            width={896}
            height={1251}
            widths={[384, 640, 896]}
            sizes="(min-width: 640px) 643px, 579px"
            loading="eager"
            fetchpriority="high"
            class="absolute max-w-none h-auto"
            style="width: 134%; left: -17%; top: -2%;"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTypewriter } from '../../scripts/typewriter';

  initTypewriter();
</script>
