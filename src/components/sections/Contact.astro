---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const c = t.contact;

const inputClass =
  'w-full bg-neutral-900/60 border border-white/15 focus:border-white/40 rounded-xl px-4 py-3.5 text-sm text-white placeholder:text-neutral-500 outline-none transition-colors duration-300';
const labelClass =
  'block text-[11px] font-medium uppercase tracking-[0.22em] text-neutral-300 mb-2';
---

<section id="contacto" class="py-32 sm:py-40 bg-[#050505] scroll-mt-24 border-t border-white/5">
  <div class="max-w-2xl mx-auto px-6 sm:px-8">
    <div data-reveal>
      <SectionHeader
        kicker={locale === 'en' ? 'CONTACT' : 'CONTACTO'}
        title={c.title}
        subtitle={c.subtitle}
      />
    </div>

    <form
      data-contact-form
      data-endpoint={`https://formsubmit.co/ajax/${personalInfo.email}`}
      data-email={personalInfo.email}
      class="space-y-5"
      data-reveal
      novalidate
    >
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="contact-name" class={labelClass}>{c.name}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder={c.namePlaceholder}
            class={inputClass}
          />
        </div>
        <div>
          <label for="contact-email" class={labelClass}>{c.email}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={c.emailPlaceholder}
            class={inputClass}
          />
        </div>
      </div>

      <div>
        <label for="contact-message" class={labelClass}>{c.message}</label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows={5}
          placeholder={c.messagePlaceholder}
          class={`${inputClass} resize-y min-h-32`}
        ></textarea>
      </div>

      <p data-contact-status class="hidden text-sm font-light" role="status" aria-live="polite"></p>
      <p data-contact-error class="hidden text-sm font-light text-rose-300" role="alert"></p>

      <!-- Honeypot anti-spam (oculto para humanos) -->
      <div class="hidden" aria-hidden="true">
        <label>Empresa <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div>
        <button
          type="submit"
          data-contact-submit
          data-sending={c.sending}
          data-success={c.success}
          data-error={c.error}
          data-error-required={c.errorRequired}
          data-error-invalid={c.errorInvalid}
          data-fallback={c.fallback}
          class="btn btn-primary btn-block disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span data-contact-label>{c.send}</span>
          <Icon name="arrow-right" size={14} />
        </button>
      </div>
    </form>

    <p class="mt-8 text-center text-sm text-neutral-400 font-light" data-reveal>
      {c.orWrite}{' '}
      <a
        href={`mailto:${personalInfo.email}`}
        class="text-neutral-200 select-all underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white/70 transition-colors"
      >
        {personalInfo.email}
      </a>
    </p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-contact-submit]');
  const label = submit?.querySelector<HTMLElement>('[data-contact-label]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');
  const errorBox = form?.querySelector<HTMLElement>('[data-contact-error]');

  const originalLabel = label?.textContent?.trim() ?? '';
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function showStatus(message: string, ok: boolean): void {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'text-emerald-300', 'text-rose-300');
    status.classList.add(ok ? 'text-emerald-300' : 'text-rose-300');
  }

  function showError(message: string): void {
    if (!errorBox) return;
    if (!message) {
      errorBox.textContent = '';
      errorBox.classList.add('hidden');
      return;
    }
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  }

  function showFallback(to: string, fromName: string, fromEmail: string, body: string): void {
    if (!errorBox || !to) return;
    errorBox.textContent = '';
    const label = document.createElement('span');
    label.textContent = `${submit?.getAttribute('data-fallback') ?? 'Open email app'}: `;
    const link = document.createElement('a');
    link.href = `mailto:${to}?subject=${encodeURIComponent(`Mensaje del portafolio — ${fromName}`)}&body=${encodeURIComponent(`${body}\n\n— ${fromName} (${fromEmail})`)}`;
    link.className = 'underline underline-offset-4 text-neutral-200 hover:text-white';
    link.textContent = to;
    errorBox.append(label, link);
    errorBox.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submit) return;

    const endpoint = form.getAttribute('data-endpoint') ?? '';
    const data = new FormData(form);
    // Si el honeypot viene relleno, es un bot: simular éxito sin enviar
    if (String(data.get('company') ?? '').trim()) {
      showStatus(submit.getAttribute('data-success') ?? 'OK', true);
      form.reset();
      return;
    }
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    if (!name || !email || !message) {
      showError(submit.getAttribute('data-error-required') ?? 'Completa todos los campos.');
      return;
    }
    if (!emailRe.test(email) || message.length < 10) {
      showError(submit.getAttribute('data-error-invalid') ?? 'Revisa tu correo y escribe al menos 10 caracteres.');
      return;
    }
    showError('');

    const sendingLabel = submit.getAttribute('data-sending') ?? '...';
    submit.disabled = true;
    if (label) label.textContent = sendingLabel;

    try {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          name,
          email,
          message,
          _subject: `Nuevo mensaje del portafolio — ${name}`,
          _template: 'table',
          _captcha: 'false',
        }),
        signal: controller.signal,
      });
      window.clearTimeout(timeout);
      if (!response.ok) throw new Error('send failed');
      // FormSubmit responde HTTP 200 incluso cuando NO envía:
      // hay que leer el JSON y comprobar `success` ("true"/true).
      let sent = false;
      let failReason = `http ${response.status}`;
      try {
        const result = (await response.json()) as { success?: boolean | string; message?: string };
        sent = result?.success === true || result?.success === 'true';
        if (!sent) failReason = result?.message ?? JSON.stringify(result).slice(0, 140);
      } catch {
        sent = false;
      }
      if (!sent) throw new Error(failReason);
      const okMsg = submit.getAttribute('data-success') ?? 'OK';
      showStatus(okMsg, true);
      form.reset();
    } catch (err) {
      console.warn('[contacto] envío fallido:', err);
      const errMsg = submit.getAttribute('data-error') ?? 'Error';
      showStatus(errMsg, false);
      showFallback(form.getAttribute('data-email') ?? '', name, email, message);
    } finally {
      submit.disabled = false;
      if (label) label.textContent = originalLabel;
    }
  });
</script>
