---
import Icon from './ui/Icon.astro';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
  label?: string;
}

const { locale, label } = Astro.props;

const options: { code: Locale; name: string; flag: string }[] = [
  { code: 'es', name: 'Español', flag: '🇨🇴' },
  { code: 'en', name: 'English', flag: '🇺🇸' },
];

const current = options.find((o) => o.code === locale) ?? options[0];
---

<div class="flex items-center gap-2">
  {label && <span class="text-neutral-500 text-[10px] uppercase tracking-[0.2em]">{label}</span>}
  <div class="relative" data-lang-switcher>
    <button
      type="button"
      data-lang-toggle
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Select language"
      class="flex items-center gap-1.5 text-neutral-200 hover:text-white transition-colors text-xs font-semibold tracking-[0.25em] uppercase py-1 px-1.5 rounded focus:outline-none"
    >
      <span class="text-xs" aria-hidden="true">{current.flag}</span>
      <span>{current.code}</span>
      <Icon name="chevron-down" size={10} class="transition-transform duration-200 text-neutral-500" data-lang-chevron />
    </button>

    <div
      data-lang-menu
      hidden
      class="absolute top-full right-0 mt-2 w-32 bg-[#0a0a0a]/95 backdrop-blur-md border border-white/10 rounded-md shadow-2xl overflow-hidden z-50 py-1"
    >
      {
        options.map((option) => (
          <a
            href={`/${option.code}/`}
            data-lang-option
            hreflang={option.code}
            lang={option.code}
            aria-current={option.code === locale ? 'true' : undefined}
            class:list={[
              'w-full flex items-center gap-2 px-3 py-2 text-left text-[11px] uppercase tracking-[0.18em] text-neutral-400 hover:text-white hover:bg-white/5 transition-colors',
              option.code === locale && 'text-white bg-white/[0.08]',
            ]}
          >
            <span class="text-xs" aria-hidden="true">
              {option.flag}
            </span>
            <span>{option.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  if (!document.documentElement.dataset.langSwitcherInit) {
    document.documentElement.dataset.langSwitcherInit = 'true';
    document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((switcher) => {
    const toggle = switcher.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    const menu = switcher.querySelector<HTMLElement>('[data-lang-menu]');
    const chevron = switcher.querySelector<HTMLElement>('[data-lang-chevron]');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean): void => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(menu.hidden);
    });

    const options = [...menu.querySelectorAll<HTMLAnchorElement>('[data-lang-option]')];
    const withHash = (): string => window.location.hash;

    options.forEach((option) => {
      option.addEventListener('click', () => {
        window.location.href = `${option.getAttribute('href') ?? '/'}${withHash()}`;
      });
    });

    const syncHref = (): void => {
      options.forEach((option) => {
        const base = option.getAttribute('href')?.split('#')[0] ?? '/';
        option.href = `${base}${withHash()}`;
      });
    };

    syncHref();
    window.addEventListener('hashchange', syncHref);

    document.addEventListener('mousedown', (event) => {
      if (menu.hidden) return;
      if (!switcher.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  });
  }
</script>
