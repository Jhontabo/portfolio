---
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const year = new Date().getFullYear();

const githubPath =
  'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z';
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<footer id="footer" class="bg-[#050505]">
  <!-- Banner del hero reutilizado como cierre visual (misma presentación que arriba) -->
  <div class="hero-image-wrapper relative z-0 w-full flex items-center justify-center overflow-hidden select-none">
    <picture class="contents">
      <source media="(max-width: 767px)" srcset="/desing-mobil.webp" />
      <img
        src="/Desing-final.webp"
        alt=""
        width="2400"
        height="1260"
        loading="lazy"
        decoding="async"
        class="hero-banner object-center pointer-events-none"
      />
    </picture>

    <!-- Capa oscura para que los iconos sean los protagonistas -->
    <div
      class="absolute inset-0 bg-black/60 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <!-- Fundido perimetral superior (igual que el hero) -->
    <div
      class="absolute inset-x-0 top-0 h-14 sm:h-20 md:h-28 bg-gradient-to-b from-[#050505] via-[#050505]/70 to-transparent pointer-events-none z-10"
    >
    </div>

    <!-- Fundido perimetral inferior (igual que el hero) -->
    <div
      class="absolute inset-x-0 bottom-0 h-16 sm:h-24 md:h-32 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-transparent pointer-events-none z-10"
      aria-hidden="true"
    >
    </div>

    <!-- Redes sociales centradas sobre la foto -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex items-center gap-4 sm:gap-12">
      <a
        href={personalInfo.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="w-14 h-14 sm:w-24 sm:h-24 rounded-full bg-black/50 backdrop-blur-md border border-[#E4405F]/60 text-[#E4405F] hover:bg-gradient-to-tr hover:from-[#F58529] hover:via-[#DD2A7B] hover:to-[#8134AF] hover:text-white hover:border-transparent hover:shadow-[0_0_36px_rgba(221,42,123,0.55)] transition-all duration-300 flex items-center justify-center hover:-translate-y-1 hover:scale-105"
      >
        <BrandIcon name="instagram" size={36} class="w-6 h-6 sm:w-9 sm:h-9" color="currentColor" />
      </a>
      <a
        href={personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="w-14 h-14 sm:w-24 sm:h-24 rounded-full bg-black/50 backdrop-blur-md border border-white/40 text-white hover:bg-white hover:text-black hover:border-white hover:shadow-[0_0_36px_rgba(255,255,255,0.35)] transition-all duration-300 flex items-center justify-center hover:-translate-y-1 hover:scale-105"
      >
        <BrandIcon name="github" size={36} class="w-6 h-6 sm:w-9 sm:h-9" color="currentColor" />
      </a>
      <a
        href={personalInfo.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-14 h-14 sm:w-24 sm:h-24 rounded-full bg-black/50 backdrop-blur-md border border-[#0A66C2]/70 text-[#0A66C2] hover:bg-[#0A66C2] hover:text-white hover:border-[#0A66C2] hover:shadow-[0_0_36px_rgba(10,102,194,0.6)] transition-all duration-300 flex items-center justify-center hover:-translate-y-1 hover:scale-105"
      >
        <BrandIcon name="linkedin" size={36} class="w-6 h-6 sm:w-9 sm:h-9" color="currentColor" />
      </a>
      <a
        href={personalInfo.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="w-14 h-14 sm:w-24 sm:h-24 rounded-full bg-black/50 backdrop-blur-md border border-[#1877F2]/70 text-[#1877F2] hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2] hover:shadow-[0_0_36px_rgba(24,119,242,0.6)] transition-all duration-300 flex items-center justify-center hover:-translate-y-1 hover:scale-105"
      >
        <BrandIcon name="facebook" size={36} class="w-6 h-6 sm:w-9 sm:h-9" color="currentColor" />
      </a>
      <a
        href={`mailto:${personalInfo.email}`}
        aria-label="Email"
        class="w-14 h-14 sm:w-24 sm:h-24 rounded-full bg-black/50 backdrop-blur-md border border-white/40 text-white hover:bg-white hover:text-black hover:border-white hover:shadow-[0_0_36px_rgba(255,255,255,0.35)] transition-all duration-300 flex items-center justify-center hover:-translate-y-1 hover:scale-105"
      >
        <Icon name="mail" size={36} class="w-6 h-6 sm:w-9 sm:h-9" />
      </a>
    </div>
  </div>

  <div class="py-16 sm:py-20 border-t border-white/10">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 flex flex-col gap-12">
    <!-- Fila Superior: Marca y Enlaces Sociales -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <a href="#home" class="font-serif text-lg sm:text-xl tracking-[0.25em] text-white uppercase hover:text-neutral-300 transition-colors">
          JHON TAJUMBINA
        </a>
        <p class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 mt-1 font-light">
          {locale === 'en' ? 'Engineering & Digital Marketing' : 'Ingeniería de Sistemas & Estrategia Digital'}
        </p>
      </div>

      <div class="flex items-center gap-6">
        <a
          href={personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-neutral-400 hover:text-white transition-colors"
          aria-label="GitHub"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={githubPath}></path>
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href={personalInfo.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-neutral-400 hover:text-white transition-colors"
          aria-label="LinkedIn"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={linkedinPath}></path>
          </svg>
          <span>LinkedIn</span>
        </a>

        <a
          href={`mailto:${personalInfo.email}`}
          class="flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-neutral-400 hover:text-white transition-colors"
          aria-label="Email"
        >
          <span>Email</span>
        </a>
      </div>
    </div>

    <div class="h-px bg-white/5 w-full"></div>

    <!-- Fila Inferior: Copyright y Navegación rápida -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-light">
        © {year} Jhon Tajumbina. {t.footer.rights}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-6">
        <a
          href="#home"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.home}
        </a>
        <a
          href="#about"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.about}
        </a>
        <a
          href="#journey"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.journey}
        </a>
        <a
          href="#portfolio"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.portfolio}
        </a>
        <a
          href="#skills"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.skills.title}
        </a>
      </div>
    </div>
  </div>
  </div>
</footer>
