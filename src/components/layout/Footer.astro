---
import Icon from '../ui/Icon.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative py-10 bg-[#040406] border-t border-white/5">
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent"
  >
  </div>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <p class="text-zinc-500 text-sm font-mono flex flex-wrap items-center justify-center gap-2">
      <span>© {year}</span>
      <span class="text-zinc-400">{personalInfo.name}</span>
      <span class="text-zinc-600">|</span>
      <span class="flex items-center gap-1.5">
        {t.footer.madeWith}
        <Icon name="heart" size={12} class="inline text-cyan-400 fill-cyan-400/20" />
      </span>
    </p>
    <div class="flex items-center gap-6">
      <a
        href="#home"
        class="text-zinc-500 hover:text-cyan-400 text-sm font-mono transition-colors"
        >
        # {t.nav.home.toLowerCase()}
      </a>
      <a
        href="#journey"
        class="text-zinc-500 hover:text-cyan-400 text-sm font-mono transition-colors"
        >
        # {t.nav.journey.toLowerCase()}
      </a>
      <a
        href="#portfolio"
        class="text-zinc-500 hover:text-cyan-400 text-sm font-mono transition-colors"
        >
        # {t.nav.portfolio.toLowerCase()}
      </a>
    </div>
  </div>
</footer>
