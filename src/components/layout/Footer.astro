---
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="footer" class="bg-[#050505]">
  <!-- Banner del hero reutilizado como cierre visual (misma presentación que arriba) -->
  <div class="hero-image-wrapper relative z-0 w-full flex items-center justify-center overflow-hidden select-none">
    <picture class="contents">
      <source media="(max-width: 767px)" srcset="/desing-mobil.webp" />
      <img
        src="/diseno-footer.webp"
        alt=""
        width="2400"
        height="1260"
        loading="lazy"
        decoding="async"
        class="hero-banner object-center pointer-events-none"
      />
    </picture>

    <!-- Capa oscura para que los iconos sean los protagonistas -->
    <div
      class="absolute inset-0 bg-black/60 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <!-- Fundido perimetral superior (igual que el hero) -->
    <div
      class="absolute inset-x-0 top-0 h-14 sm:h-20 md:h-28 bg-gradient-to-b from-[#050505] via-[#050505]/70 to-transparent pointer-events-none z-10"
    >
    </div>

    <!-- Fundido perimetral inferior (igual que el hero) -->
    <div
      class="absolute inset-x-0 bottom-0 h-16 sm:h-24 md:h-32 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-transparent pointer-events-none z-10"
      aria-hidden="true"
    >
    </div>

    <!-- Redes sociales siempre visibles sobre la foto -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex items-center gap-4 sm:gap-16">
      <a
        href={personalInfo.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="w-14 h-14 sm:w-28 sm:h-28 rounded-full bg-black/50 backdrop-blur-md border border-[#E4405F]/60 text-[#E4405F] hover:bg-gradient-to-tr hover:from-[#F58529] hover:via-[#DD2A7B] hover:to-[#8134AF] hover:text-white hover:border-transparent hover:shadow-[0_0_36px_rgba(221,42,123,0.55)] flex items-center justify-center"
      >
        <BrandIcon name="instagram" size={36} class="w-6 h-6 sm:w-11 sm:h-11" color="currentColor" />
      </a>
      <a
        href={personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="w-14 h-14 sm:w-28 sm:h-28 rounded-full bg-black/50 backdrop-blur-md border border-white/40 text-white hover:bg-white hover:text-black hover:border-white hover:shadow-[0_0_36px_rgba(255,255,255,0.35)] flex items-center justify-center"
      >
        <BrandIcon name="github" size={36} class="w-6 h-6 sm:w-11 sm:h-11" color="currentColor" />
      </a>
      <a
        href={personalInfo.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-14 h-14 sm:w-28 sm:h-28 rounded-full bg-black/50 backdrop-blur-md border border-[#0A66C2]/70 text-[#0A66C2] hover:bg-[#0A66C2] hover:text-white hover:border-[#0A66C2] hover:shadow-[0_0_36px_rgba(10,102,194,0.6)] flex items-center justify-center"
      >
        <BrandIcon name="linkedin" size={36} class="w-6 h-6 sm:w-11 sm:h-11" color="currentColor" />
      </a>
      <a
        href={personalInfo.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="w-14 h-14 sm:w-28 sm:h-28 rounded-full bg-black/50 backdrop-blur-md border border-[#1877F2]/70 text-[#1877F2] hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2] hover:shadow-[0_0_36px_rgba(24,119,242,0.6)] flex items-center justify-center"
      >
        <BrandIcon name="facebook" size={36} class="w-6 h-6 sm:w-11 sm:h-11" color="currentColor" />
      </a>
      <a
        href="#contacto"
        aria-label="Email"
        title={personalInfo.email}
        class="w-14 h-14 sm:w-28 sm:h-28 rounded-full bg-black/50 backdrop-blur-md border border-white/40 text-white hover:bg-white hover:text-black hover:border-white hover:shadow-[0_0_36px_rgba(255,255,255,0.35)] transition-all duration-300 flex items-center justify-center hover:-translate-y-1 hover:scale-105"
      >
        <Icon name="mail" size={36} class="w-6 h-6 sm:w-11 sm:h-11" />
      </a>
    </div>
  </div>

  <div class="py-24 sm:py-28 border-t border-white/10">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 flex flex-col gap-12">
    <!-- Fila Inferior: Copyright y Navegación rápida -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-light">
        © {year} Jhon Tajumbina. {t.footer.rights}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-6">
        <a
          href="#home"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.home}
        </a>
        <a
          href="#about"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.about}
        </a>
        <a
          href="#journey"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.journey}
        </a>
        <a
          href="#portfolio"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.portfolio}
        </a>
        <a
          href="#skills"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.skills.title}
        </a>
        <a
          href="#contacto"
          class="text-[11px] uppercase tracking-[0.22em] text-neutral-400 hover:text-white transition-colors"
        >
          {t.nav.contact}
        </a>
      </div>
    </div>
  </div>
  </div>
</footer>
