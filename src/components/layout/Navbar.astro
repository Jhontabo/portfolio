---
import LanguageSwitcher from '../LanguageSwitcher.astro';
import ContactMenu from '../ui/ContactMenu.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const leftLinks = [
  { name: t.nav.about, href: '#about' },
  { name: t.nav.journey, href: '#journey' },
];

const rightLinks = [
  { name: t.nav.portfolio, href: '#portfolio' },
  { name: t.nav.contact, href: `mailto:${personalInfo.email}` },
];

const allNavLinks = [...leftLinks, ...rightLinks];
---

<header
  class="fixed top-0 left-0 right-0 z-50 w-full bg-black/70 backdrop-blur-md border-b border-white/10 transition-all duration-300 pointer-events-auto"
>
  <nav
    data-navbar
    class="w-full max-w-7xl mx-auto px-6 lg:px-12 py-5 sm:py-6 flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- BLOQUE 1 (Izquierda): Enlaces Desktop -->
    <div class="hidden md:flex items-center gap-8 justify-start flex-1">
      {
        leftLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs font-semibold uppercase tracking-[0.25em] text-white hover:text-neutral-300 transition-colors duration-200"
          >
            {link.name}
          </a>
        ))
      }
    </div>

    <!-- BLOQUE 2 (Centro): Nombre en tipografía Serif discreta -->
    <div class="flex items-center justify-center text-center">
      <a
        href="#home"
        class="font-serif text-sm sm:text-base tracking-[0.25em] sm:tracking-[0.28em] uppercase text-white hover:text-neutral-200 transition-colors duration-200 select-none font-normal"
      >
        JHON TAJUMBINA
      </a>
    </div>

    <!-- BLOQUE 3 (Derecha): Enlaces restantes + Selector de Idioma -->
    <div class="hidden md:flex items-center gap-8 justify-end flex-1">
      {
        rightLinks.map((link) =>
          link.href.startsWith('mailto:') ? (
            <ContactMenu locale={locale} align="right">
              <button
                type="button"
                aria-haspopup="true"
                class="btn btn-secondary btn-sm"
                slot="trigger"
              >
                {link.name}
              </button>
            </ContactMenu>
          ) : (
            <a
              href={link.href}
              class="text-xs font-semibold uppercase tracking-[0.25em] text-white hover:text-neutral-300 transition-colors duration-200"
            >
              {link.name}
            </a>
          )
        )
      }
      <div class="h-3 w-px bg-white/25" aria-hidden="true"></div>
      <LanguageSwitcher locale={locale} />
    </div>

    <!-- Disparador móvil (Hamburguesa minimalista) -->
    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Abrir menú de navegación"
      class="md:hidden text-white hover:text-neutral-300 p-2 transition-colors focus:outline-none"
    >
      <span data-nav-icon="menu" class="flex flex-col gap-1.5 w-5 justify-center items-end" aria-hidden="true">
        <span class="w-5 h-[1.5px] bg-neutral-300"></span>
        <span class="w-3.5 h-[1.5px] bg-neutral-300"></span>
      </span>
      <span data-nav-icon="x" hidden class="relative w-5 h-5 flex items-center justify-center" aria-hidden="true">
        <span class="absolute w-5 h-[1.5px] bg-neutral-300 rotate-45"></span>
        <span class="absolute w-5 h-[1.5px] bg-neutral-300 -rotate-45"></span>
      </span>
    </button>

    <!-- Menú desplegable móvil (Diseño editorial limpio) -->
    <div
      id="nav-drawer"
      data-nav-drawer
      class="nav-drawer absolute top-full left-0 right-0 w-full bg-[#050505]/95 backdrop-blur-xl border-b border-white/10 py-8 px-6 flex-col items-center gap-6 shadow-2xl"
    >
      <ul class="flex flex-col items-center gap-5 text-center">
        {
          allNavLinks.map((link) => (
            <li>
              {link.href.startsWith('mailto:') ? (
                <ContactMenu locale={locale}>
                  <button
                    type="button"
                    aria-haspopup="true"
                    class="font-serif text-xs uppercase tracking-[0.28em] text-neutral-300 hover:text-white transition-colors py-1 block"
                    slot="trigger"
                  >
                    {link.name}
                  </button>
                </ContactMenu>
              ) : (
                <a
                  href={link.href}
                  class="font-serif text-xs uppercase tracking-[0.28em] text-neutral-300 hover:text-white transition-colors py-1 block"
                >
                  {link.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <div class="h-px bg-white/10 w-20 my-1"></div>
      <LanguageSwitcher
        locale={locale}
        label={locale === 'es' ? 'Idioma:' : 'Language:'}
      />
    </div>
  </nav>
</header>

<script>
  import { initNavbar } from '../../scripts/navbar';

  initNavbar();
</script>
