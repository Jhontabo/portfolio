---
import Icon from '../ui/Icon.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { personalInfo } from '../../data/personal';
import type { Locale, Messages } from '../../i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const navItems = [
  { name: t.nav.home, href: '#home' },
  { name: t.nav.journey, href: '#journey' },
  { name: t.nav.portfolio, href: '#portfolio' },
];

const githubPath =
  'M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z';
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 py-4 pointer-events-none">
  <nav
    data-navbar
    class="navbar-pill w-full max-w-5xl pointer-events-auto rounded-full backdrop-blur-md px-6 py-2 flex items-center justify-between relative animate-nav-drop"
  >
    <a
      href="#home"
      class="flex items-center gap-1.5 font-mono text-sm sm:text-base font-semibold text-zinc-300 hover:text-white transition hover:scale-[1.03] shrink-0"
    >
      <span class="text-cyan-400">jt</span><span class="text-zinc-500">@</span><span
        class="text-purple-400 font-bold">arch</span><span class="text-zinc-500 font-normal"
        >~ $</span
      >
    </a>

    <div class="hidden md:flex items-center gap-8">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {
          navItems.map((link) => (
            <li>
              <a href={link.href} class="text-zinc-400 hover:text-cyan-400 transition-colors duration-200">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-4">
        <a
          href={personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-zinc-400 hover:text-cyan-400 transition-colors group"
          aria-label="GitHub"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={githubPath}></path>
          </svg>
          <span class="text-xs group-hover:text-white">GitHub</span>
        </a>
        <a
          href={personalInfo.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-zinc-400 hover:text-blue-400 transition-colors group"
          aria-label="LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={linkedinPath}></path>
          </svg>
          <span class="text-xs group-hover:text-blue-400">LinkedIn</span>
        </a>
      </div>

      <div class="h-4 w-px bg-white/10"></div>
      <LanguageSwitcher locale={locale} />
    </div>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Toggle menu"
      class="md:hidden text-zinc-300 p-1 hover:text-cyan-400 transition-colors"
    >
      <span data-nav-icon="menu"><Icon name="menu" size={20} /></span>
      <span data-nav-icon="x" hidden><Icon name="x" size={20} /></span>
    </button>

    <div
      id="nav-drawer"
      data-nav-drawer
      class="nav-drawer absolute top-full left-4 right-4 mt-2 bg-[#0b0c10]/95 border border-white/10 rounded-2xl p-5 shadow-2xl backdrop-blur-lg flex-col gap-4"
    >
      <ul class="flex flex-col gap-3 font-medium">
        {
          navItems.map((link) => (
            <li>
              <a href={link.href} class="block py-2 text-zinc-300 hover:text-cyan-400 transition-colors">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-4">
        <a
          href={personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-zinc-400 hover:text-cyan-400 transition-colors"
          aria-label="GitHub"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={githubPath}></path>
          </svg>
          <span class="text-xs">GitHub</span>
        </a>
        <a
          href={personalInfo.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-zinc-400 hover:text-blue-400 transition-colors"
          aria-label="LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={linkedinPath}></path>
          </svg>
          <span class="text-xs">LinkedIn</span>
        </a>
      </div>

      <div class="h-px bg-white/10 w-full"></div>
      <div class="flex justify-between items-center">
        <LanguageSwitcher
          locale={locale}
          label={locale === 'es' ? 'Selecciona idioma:' : 'Select language:'}
        />
      </div>
    </div>
  </nav>
</header>

<script>
  import { initNavbar } from '../../scripts/navbar';

  initNavbar();
</script>
