---
export interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  gradient?: 'cyan' | 'purple';
  id?: string;
  class?: string;
}

const { title, subtitle, kicker, id, class: className } = Astro.props;
---

<div class:list={['text-center mb-16 sm:mb-20', className]}>
  {kicker && (
    <p class="text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.3em] text-neutral-400 mb-3">
      {kicker}
    </p>
  )}
  <h2
    id={id}
    class="font-serif text-3xl sm:text-4xl md:text-5xl font-light tracking-[0.12em] text-white uppercase drop-shadow-sm mb-4"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="max-w-2xl mx-auto text-sm sm:text-base text-neutral-400 font-light leading-relaxed">
      {subtitle}
    </p>
  )}
  <div class="w-10 h-[1px] bg-white/20 mx-auto mt-6" aria-hidden="true"></div>
</div>
