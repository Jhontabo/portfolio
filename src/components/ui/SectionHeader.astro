---
export interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  gradient?: 'cyan' | 'purple';
  id?: string;
  class?: string;
}

const { title, subtitle, kicker, id, class: className } = Astro.props;
---

<div class:list={['text-center mb-16 sm:mb-20', className]}>
  {kicker && (
    <p class="text-[11px] sm:text-xs font-medium uppercase tracking-[0.3em] text-neutral-300 mb-4">
      {kicker}
    </p>
  )}
  <h2
    id={id}
    class="font-serif text-4xl sm:text-5xl md:text-6xl font-light tracking-[0.1em] uppercase hypr-gradient-text drop-shadow-[0_2px_24px_rgba(255,255,255,0.12)] mb-5"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="max-w-2xl mx-auto text-sm sm:text-base text-neutral-400 font-light leading-relaxed">
      {subtitle}
    </p>
  )}
  <div
    class="w-14 h-[2px] bg-gradient-to-r from-transparent via-white/50 to-transparent mx-auto mt-7"
    aria-hidden="true"
  >
  </div>
</div>
