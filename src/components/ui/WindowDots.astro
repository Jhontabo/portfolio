---
export interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'sm', class: className } = Astro.props;
const dot = size === 'sm' ? 'w-2 h-2' : 'w-2.5 h-2.5';
---

<div class:list={['flex gap-1.5 shrink-0', className]} aria-hidden="true">
  <span class:list={['rounded-full', dot]} style="background:#ff5f56"></span>
  <span class:list={['rounded-full', dot]} style="background:#ffbd2e"></span>
  <span class:list={['rounded-full', dot]} style="background:#27c93f"></span>
</div>
