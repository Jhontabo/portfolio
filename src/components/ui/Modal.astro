---
import Icon from './Icon.astro';

export interface Props {
  id: string;
  title?: string;
  variant?: 'window' | 'plain';
  panelClass?: string;
  bodyClass?: string;
  closeLabel?: string;
  expandedLabel?: string;
}

const {
  id,
  title,
  variant = 'window',
  panelClass = 'w-full max-w-4xl h-[85vh] bg-[#0a0a0a] rounded-2xl border border-white/10 overflow-hidden flex flex-col shadow-2xl',
  bodyClass = '',
  closeLabel = 'Cerrar modal',
  expandedLabel = 'Vista ampliada',
} = Astro.props;

const labelledBy = `modal-title-${id}`;
---

<dialog
  {id}
  class="modal fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none bg-transparent p-4 backdrop:bg-transparent"
  aria-labelledby={title ? labelledBy : undefined}
  aria-label={title ? undefined : expandedLabel}
>
  <div
    class:list={[
      'modal-panel relative mx-auto flex min-h-0',
      variant === 'plain' ? 'w-full h-full items-center justify-center' : panelClass,
    ]}
  >
    {
      title && (
        <div class="h-12 bg-[#050505] px-6 flex items-center justify-between border-b border-white/10 shrink-0">
          <span id={labelledBy} class="font-serif text-sm text-neutral-300 tracking-wide truncate pr-4">
            {title}
          </span>
          <button
            type="button"
            data-modal-close
            class="shrink-0 text-neutral-400 hover:text-white transition-colors p-1"
            aria-label={closeLabel}
          >
            <Icon name="x" size={16} />
          </button>
        </div>
      )
    }

    {
      variant === 'plain' && (
        <button
          type="button"
          data-modal-close
          class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-black/60 border border-white/10 text-white/80 hover:text-white flex items-center justify-center text-lg leading-none transition-all"
          aria-label={closeLabel}
        >
          <Icon name="x" size={16} />
        </button>
      )
    }

    <div class:list={['flex flex-col min-h-0', bodyClass]}>
      <slot />
    </div>
  </div>
</dialog>
