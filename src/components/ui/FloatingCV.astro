---
import Icon from './Icon.astro';
import type { Messages } from '../../i18n';

export interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<a
  href="/cv.pdf"
  download
  aria-label={t.hero.downloadCV}
  title={t.hero.downloadCV}
  class="group fixed bottom-6 right-6 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[#38bdf8] to-[#0369a1] text-white shadow-[0_8px_30px_rgba(56,189,248,0.45)] transition-transform duration-300 hover:scale-110"
>
  <span
    class="absolute inset-0 rounded-full bg-[#38bdf8] opacity-30 animate-ping"
    aria-hidden="true"
  ></span>
  <Icon name="download" size={26} />
  <span
    class="pointer-events-none absolute right-16 whitespace-nowrap rounded-lg border border-white/15 bg-black/90 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
  >
    {t.hero.downloadCV}
  </span>
</a>
