---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { SITE_NAME } from '../lib/seo';
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#050505" />
    <title>404 | {SITE_NAME}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="antialiased bg-[#050505] text-neutral-200 selection:bg-white selection:text-black">
    <div class="min-h-screen flex items-center justify-center px-6 relative overflow-hidden">
      <!-- Backlight sutil -->
      <div class="w-[500px] h-[500px] rounded-full bg-white/[0.02] blur-[140px] pointer-events-none absolute -z-10"></div>

      <div class="max-w-md w-full text-center">
        <p class="text-[11px] uppercase tracking-[0.3em] text-neutral-400 mb-3">ERROR 404</p>
        <p class="font-serif text-7xl sm:text-8xl font-light tracking-[0.15em] text-white mb-4">
          404
        </p>
        <h1 class="font-serif text-xl sm:text-2xl text-neutral-200 font-light tracking-wide mb-3">
          <span data-404-title-es>Página no encontrada</span>
          <span data-404-title-en hidden>
            Page not found
          </span>
        </h1>
        <p data-404-desc-es class="text-neutral-400 text-sm font-light leading-relaxed mb-8">
          La página solicitada no está disponible o ha sido trasladada.
        </p>
        <p data-404-desc-en hidden class="text-neutral-400 text-sm font-light leading-relaxed mb-8">
          The requested page is unavailable or has been moved.
        </p>

        <div class="flex items-center justify-center gap-4">
          <a href="/es/" data-404-cta class="btn btn-primary">
            Volver al inicio
          </a>
        </div>
      </div>
    </div>

    <script>
      // 404 bilingüe: si viene de /en/ o el navegador está en inglés, mostrar EN
      const isEn =
        document.referrer.includes('/en/') ||
        (!document.referrer && navigator.language.startsWith('en'));
      if (isEn) {
        document.documentElement.lang = 'en';
        document.querySelector('[data-404-title-es]')?.setAttribute('hidden', '');
        document.querySelector('[data-404-desc-es]')?.setAttribute('hidden', '');
        document.querySelector('[data-404-title-en]')?.removeAttribute('hidden');
        document.querySelector('[data-404-desc-en]')?.removeAttribute('hidden');
        const cta = document.querySelector('[data-404-cta]');
        if (cta) {
          cta.setAttribute('href', '/en/');
          cta.textContent = 'Back to home';
        }
      }
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
