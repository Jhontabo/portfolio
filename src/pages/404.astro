---
import '../styles/global.css';
import { SITE_NAME } from '../lib/seo';
---

<!doctype html>
<html lang="es-CO" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>404 | {SITE_NAME}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="antialiased bg-[#050505] text-neutral-200 selection:bg-white selection:text-black">
    <div class="min-h-screen flex items-center justify-center px-6 relative overflow-hidden">
      <!-- Backlight sutil -->
      <div class="w-[500px] h-[500px] rounded-full bg-white/[0.02] blur-[140px] pointer-events-none absolute -z-10"></div>

      <div class="max-w-md w-full text-center">
        <p class="text-[11px] uppercase tracking-[0.3em] text-neutral-400 mb-3">
          ERROR 404
        </p>
        <p class="font-serif text-7xl sm:text-8xl font-light tracking-[0.15em] text-white mb-4">
          404
        </p>
        <h1 class="font-serif text-xl sm:text-2xl text-neutral-200 font-light tracking-wide mb-3">
          Página no encontrada
        </h1>
        <p class="text-neutral-400 text-sm font-light leading-relaxed mb-8">
          La página solicitada no está disponible o ha sido trasladada.
        </p>

        <div class="flex items-center justify-center gap-4">
          <a
            href="/es/"
            class="inline-flex items-center border border-white/20 hover:border-white text-white rounded-full px-8 py-3.5 text-xs uppercase tracking-[0.25em] font-medium transition-all duration-300 hover:bg-white/5"
          >
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
