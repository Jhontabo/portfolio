---
import BaseHead from '../../components/layout/BaseHead.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Navbar from '../../components/layout/Navbar.astro';
import Hero from '../../components/sections/Hero.astro';
import About from '../../components/sections/About.astro';
import Projects from '../../components/sections/Projects.astro';
import Journey from '../../components/sections/Journey.astro';
import Certificates from '../../components/sections/Certificates.astro';
import Skills from '../../components/sections/Skills.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/layout/Footer.astro';
import FloatingCV from '../../components/ui/FloatingCV.astro';
import { isLocale, htmlLang, locales, t, type Locale } from '../../i18n';
import '../../styles/global.css';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { lang } = Astro.params;

if (!isLocale(lang)) {
  return Astro.redirect('/404', 302);
}

const locale = lang as Locale;
const messages = t(locale);
---

<!doctype html>
<html lang={htmlLang[locale]} translate="no" class="scroll-smooth">
  <head>
    <BaseHead locale={locale} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="antialiased bg-[#050505] text-neutral-200 selection:bg-white selection:text-black">
    <main class="min-h-screen relative overflow-hidden bg-[#050505]">
      <Navbar locale={locale} t={messages} />
      <Hero locale={locale} t={messages} />
      <About locale={locale} t={messages} />
      <Projects locale={locale} t={messages} />
      <Journey locale={locale} t={messages} />
      <Certificates locale={locale} t={messages} />
      <Skills locale={locale} t={messages} />
      <Contact locale={locale} t={messages} />
      <Footer locale={locale} t={messages} />
    </main>
    <FloatingCV t={messages} />

    <script>
      import { initReveal } from '../../scripts/reveal';

      initReveal();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
