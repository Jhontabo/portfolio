---
import { defaultLocale } from '../i18n';
import { SITE_URL } from '../lib/seo';

const target = new URL(`/${defaultLocale}/`, Astro.site ?? new URL(SITE_URL));
---

<!doctype html>
<html lang="es-CO" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={target.href} />
    <meta http-equiv="refresh" content={`0; url=${target.pathname}`} />
    <title>Jhon Tajumbina | Full-Stack Developer</title>
  </head>
  <body
    style="background:#040406;color:#e2e8f0;font-family:ui-monospace,monospace;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"
  >
    <p>
      <span style="color:#00e5d0">&gt; </span>redirigiendo a
      <a href={`/${defaultLocale}/`} style="color:#a855f7">/{defaultLocale}/</a>…
    </p>
  </body>
</html>
